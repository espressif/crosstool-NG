ARG MESON_VERSION="1.10.2"
ARG NINJA_VERSION="1.13.0"

# install picolibc build dependencies (venv avoids PEP 668 externally-managed-environment)
RUN apt-get -o Acquire::Check-Valid-Until=false update \
  && apt-get install -y --no-install-recommends python3 python3-venv python-is-python3 \
  && rm -rf /var/lib/apt/lists/* \
  && python3 -m venv /opt/picolibc-venv \
  && /opt/picolibc-venv/bin/pip install --upgrade pip \
  && /opt/picolibc-venv/bin/pip install meson==${MESON_VERSION} ninja==${NINJA_VERSION}

ENV PATH="/opt/picolibc-venv/bin:${PATH}"
