+void
+xtensa_split_operand_unpaired (rtx operands[4], machine_mode mode)
+{
+  if ((GET_CODE (operands[0]) == REG && FP_REG_P (REGNO (operands[0]))) &&
+    (GET_CODE (operands[1]) == REG && GP_REG_P (REGNO (operands[1]))))
+    {
+      operands[2] = gen_rtx_REG (mode, REGNO (operands[1]));
+      operands[1] = gen_rtx_REG (mode, REGNO (operands[1]) + 1);
+    }
+  if ((GET_CODE (operands[0]) == REG && GP_REG_P (REGNO (operands[0]))) &&
+    (GET_CODE (operands[1]) == REG && FP_REG_P (REGNO (operands[1]))))
+    {
+      operands[2] = operands[1];
+      operands[1] = gen_rtx_REG (mode, REGNO (operands[0]) + 1);
+      operands[0] = gen_rtx_REG (mode, REGNO (operands[0]));
+    }
+}
+
+/* Return true if a move from SRC to DEST should be split into two.
+   SPLIT_TYPE describes the split condition.  */
+
+bool
+xtensa_split_move_p (rtx dest, rtx src, enum xtensa_split_type split_type)
+{
+  unsigned int size = GET_MODE_SIZE (GET_MODE (dest));
+
+  if (split_type == SPLIT_IF_NECESSARY)
+    {
+  /* FPR-to-FPR moves can be done in a single instruction, if they're
+     allowed at all.  */
+  if (size == 8 && FP_REG_P (REGNO (src)) && FP_REG_P (REGNO (dest)))
+    return false;
+
+  /* Check for double floating-point loads and stores.  */
+  if (size == 8 /* && dfp support ! */)
+    {
+      if ((GET_CODE (dest) == REG && FP_REG_P(REGNO(dest))) && (GET_CODE (src) == MEM))
+	return false;
+      if ((GET_CODE (src) == REG && FP_REG_P(REGNO(src))) && (GET_CODE (dest) == MEM))
+	return false;
+    }
+    }
+
+  if (split_type == SPLIT_FOR_SPEED)
+    {
+  /* Check for moves between double floating-point and address register.  */
+  if ((size == 8 || GET_MODE_SIZE (GET_MODE (src)) == 8) /* && dfp support ! */)
+    {
+      if ((GET_CODE (dest) == REG && GP_REG_P(REGNO(dest))) && (GET_CODE (src) == REG && FP_REG_P(REGNO(src))))
+	return false;
+      if ((GET_CODE (src) == REG && GP_REG_P(REGNO(src))) && (GET_CODE (dest) == REG && FP_REG_P(REGNO(dest))))
+	return false;
+    }
+    }
+
+  /* Otherwise split all multiword moves.  */
+  return size > UNITS_PER_WORD;
+}
+
+/* Return the appropriate instructions to move SRC into DEST.  Assume
+   that SRC is operand 1 and DEST is operand 0.  */
+
+const char *
+xtensa_output_move (rtx dest, rtx src)
+{
+  enum rtx_code dest_code, src_code;
+  machine_mode mode;
+  bool dbl_p;
+
+  dest_code = GET_CODE (dest);
+  src_code = GET_CODE (src);
+  mode = GET_MODE (dest);
+  dbl_p = (GET_MODE_SIZE (mode) == 8);
+
+  if (xtensa_split_move_p(dest, src, SPLIT_IF_NECESSARY))
+    return "#";
+
+  if ((src_code == REG) && FP_REG_P (REGNO (src)))
+  {
+    if ((dest_code == REG) && FP_REG_P (REGNO (dest)))
+      return "mov.d\t%0, %1"; /* FPR-to-FPR moves */
+
+    if ((dest_code == MEM) /* && condition ? */ )
+      return "%v0sdi\t%1, %0";
+  }
+  if ((src_code == MEM) /* && condition ? */ )
+  {
+    if ((dest_code == REG) && FP_REG_P (REGNO (dest)))
+      return "%v1ldi\t%0, %1";
+  }
+}
 
