 		}
+		if (TARGET_ESP32_PSRAM_FIX_MEMW && attr_type == TYPE_JUMP) {
+			//jump/ret
+			emit_insn_before(gen_memory_barrier(), insn);
+		}
 	} else {
 		insns_since_store++;
 	}
