diff --git a/gcc/config/xtensa/xtensa.c b/gcc/config/xtensa/xtensa.c
index eda29d4..4818f59 100644
--- a/gcc/config/xtensa/xtensa.c
+++ b/gcc/config/xtensa/xtensa.c
@@ -2286,8 +2286,12 @@ static void handle_fix_reorg_insn(rtx_insn *insn) {
 	} else if (attr_type == TYPE_LOAD || attr_type == TYPE_FLOAD) {
 		//Load
 		if (store_insn) {
-			while (insns_since_store++ < LOAD_STORE_OFF) {
-				emit_insn_before (gen_nop(), insn);
+			if (TARGET_ESP32_PSRAM_FIX_MEMW) {
+				emit_insn_before(gen_memory_barrier(), insn);
+			} else {
+				while (insns_since_store++ < LOAD_STORE_OFF) {
+					emit_insn_before (gen_nop(), insn);
+				}
 			}
 		}
 	} else if (attr_type == TYPE_JUMP || attr_type == TYPE_CALL) {
@@ -2295,6 +2299,10 @@ static void handle_fix_reorg_insn(rtx_insn *insn) {
