CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_PREFIX_DIR="${CT_TOP_DIR}/builds/${CT_TARGET}"

CT_ARCH_XTENSA=y
CT_ARCH="xtensa"
CT_TARGET_CFLAGS="-mlongcalls"
CT_MULTILIB=y
CT_TARGET_VENDOR="esp"
CT_XTENSA_DYNCONFIG=y
CT_XTENSA_DYNCONFIG_LOCATION="${CT_TOP_DIR}/xtensa-dynconfig"
CT_XTENSA_DYNCONFIG_CONF_DIR="${CT_TOP_DIR}/overlays"
CT_XTENSA_ESP_BIN_WRAPPERS_LOCATION="${CT_TOP_DIR}/esp-toolchain-bin-wrappers/gnu-xtensa-toolchian"

CT_CC_GCC_ENABLE_PLUGINS=y
CT_CC_GCC_USE_LTO=y
CT_CC_GCC_LTO_ZSTD=y
CT_CC_GCC_ENABLE_CXX_FLAGS="-ffunction-sections -fdata-sections"
CT_CC_GCC_CORE_EXTRA_CONFIG_ARRAY="--enable-threads=posix"
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--disable-libstdcxx-verbose --enable-threads=posix --enable-libstdcxx-time=yes --disable-win32-utf8-manifest"
# CT_CC_CXA_ATEXIT is not set
# CT_CC_GCC_STATIC_LIBSTDCXX is not set
# CT_CC_GCC_LDBL_128 is not set
CT_CC_LANG_CXX=y

# NOTE: crosstool-ng doesn't apply bundled patches in the case of using git repo

CT_NEWLIB_SRC_DEVEL=y
CT_NEWLIB_DEVEL_URL="https://github.com/espressif/newlib-esp32.git"
CT_NEWLIB_DEVEL_BRANCH="esp-4.6.0-dev"
CT_LIBC_NEWLIB_EXTRA_CONFIG_ARRAY="--enable-newlib-iconv --enable-newlib-reent-binary-compat"
CT_LIBC_NEWLIB_NANO_MALLOC=y
CT_LIBC_NEWLIB_RETARGETABLE_LOCKING=y
CT_LIBC_NEWLIB_GLOBAL_ATEXIT=y
CT_LIBC_NEWLIB_DISABLE_SUPPLIED_SYSCALLS=y
CT_LIBC_NEWLIB_REENT_SMALL=y
CT_LIBC_NEWLIB_IO_C99FMT=y
CT_LIBC_NEWLIB_IO_LL=y
CT_LIBC_NEWLIB_IO_FLOAT=y
CT_LIBC_NEWLIB_IO_POS_ARGS=y
CT_LIBC_NEWLIB_WIDE_ORIENT=n

CT_COMP_LIBS_NEWLIB_NANO=y
CT_NEWLIB_NANO_SRC_DEVEL=y
CT_NEWLIB_NANO_DEVEL_URL="https://github.com/espressif/newlib-esp32.git"
CT_NEWLIB_NANO_DEVEL_BRANCH="esp-4.6.0-dev"
CT_LIBC_NEWLIB_NANO_EXTRA_CONFIG_ARRAY="--enable-newlib-iconv --enable-newlib-reent-binary-compat"
CT_LIBC_NEWLIB_NANO_RETARGETABLE_LOCKING=y
CT_LIBC_NEWLIB_NANO_IO_FLOAT=y
CT_LIBC_NEWLIB_NANO_IO_C99FMT=n
CT_LIBC_NEWLIB_NANO_DISABLE_SUPPLIED_SYSCALLS=y
CT_LIBC_NEWLIB_NANO_NANO_FORMATTED_IO=y
CT_LIBC_NEWLIB_NANO_NANO_MALLOC=y
CT_LIBC_NEWLIB_NANO_REENT_SMALL=y
CT_LIBC_NEWLIB_NANO_WIDE_ORIENT=n

CT_COMP_LIBS_PICOLIBC=y
CT_LIBC_PICOLIBC_GCC_LIBSTDCXX=y

CT_PICOLIBC_SRC_DEVEL=y
CT_PICOLIBC_DEVEL_URL="https://github.com/espressif/picolibc.git"
CT_PICOLIBC_DEVEL_BRANCH="esp-1.8.11-dev"
CT_LIBC_PICOLIBC_EXTRA_CONFIG_ARRAY="-Dio-long-long=true -Dhave-fcntl=true -Dsysroot-install=true -Dsysroot-install-skip-checks=true -Dsemihost=false -Dpicocrt=true -Dpicocrt-lib=false -Dio-c99-formats=true -Dio-pos-args=true -Dposix-console=true -Dstdio-locking=true -Dfast-bufio=true -Dfstat-bufsiz=true -Dmultilib-exclude=esp8266"

CT_GCC_SRC_DEVEL=y
CT_GCC_DEVEL_URL="https://github.com/espressif/gcc.git"
CT_GCC_DEVEL_BRANCH="esp-16_1_0-dev"

CT_BINUTILS_SRC_DEVEL=y
CT_BINUTILS_DEVEL_URL="https://github.com/espressif/binutils-gdb.git"
CT_BINUTILS_DEVEL_BRANCH="esp-binutils-2_46-dev"
CT_BINUTILS_PLUGINS=y
