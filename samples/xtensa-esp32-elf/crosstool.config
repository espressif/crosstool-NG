CT_EXPERIMENTAL=y
CT_PREFIX_DIR="${CT_TOP_DIR}/builds/${CT_TARGET}"
CT_TARGET_CFLAGS="-mlongcalls"
CT_ARCH_XTENSA=y
CT_XTENSA_CUSTOM=y
CT_ARCH_XTENSA_CUSTOM_NAME="esp32"
CT_TARGET_VENDOR="esp32"
CT_LIBC_NEWLIB_DISABLE_SUPPLIED_SYSCALLS=y
CT_CC_LANG_CXX=y
CT_CC_GCC_ENABLE_CXX_FLAGS="-fno-rtti -ffunction-sections"
CT_CC_GCC_CORE_EXTRA_CONFIG_ARRAY="--enable-threads=posix"
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--disable-libstdcxx-verbose --enable-threads=posix --enable-gcov-custom-rtio"
# CT_CC_CXA_ATEXIT is not set
# CT_CC_GCC_STATIC_LIBSTDCXX is not set
# CT_CC_GCC_LDBL_128 is not set
CT_DEBUG_GDB=y
CT_MULTILIB=y
CT_OVERLAY_NAME="esp32"
CT_OVERLAY_LOCATION="${CT_TOP_DIR}/overlays"

# NOTE: crosstool-ng doesn't apply bundled patches in the case of using git repo

CT_NEWLIB_V_3_0_0=y
CT_NEWLIB_VERSION="3.0.0.20180226"
CT_NEWLIB_SRC_DEVEL=y
CT_NEWLIB_DEVEL_VCS_git=y
CT_NEWLIB_DEVEL_VCS="git"
# TODO change to public hosting
CT_NEWLIB_DEVEL_URL="ssh://git@gitlab.espressif.cn:27227/idf/newlib-cygwin.git"
CT_NEWLIB_DEVEL_BRANCH="esp32_based_on-3_0_0_20180226"
CT_NEWLIB_DEVEL_REVISION=""
CT_NEWLIB_DEVEL_SUBDIR=""
CT_NEWLIB_DEVEL_BOOTSTRAP=""

CT_GCC_V_8_1_0=y
CT_GCC_VERSION="8.1.0"
CT_GCC_SRC_DEVEL=y
CT_GCC_DEVEL_VCS_git=y
CT_GCC_DEVEL_VCS="git"
# TODO change to public hosting
CT_GCC_DEVEL_URL="ssh://git@gitlab.espressif.cn:27227/idf/gcc.git"
CT_GCC_DEVEL_BRANCH="esp32_based_on_8_1_0"
CT_GCC_DEVEL_REVISION=""
CT_GCC_DEVEL_SUBDIR=""
CT_GCC_DEVEL_BOOTSTRAP=""
