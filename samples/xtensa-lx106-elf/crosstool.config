#
# crosstool-NG behavior
#
CT_EXPERIMENTAL=y

#
# Paths
#
CT_PREFIX_DIR="${CT_TOP_DIR}/builds/${CT_TARGET}"

#
# Target options
#
CT_ARCH_XTENSA=y
CT_XTENSA_CUSTOM=y

#
# Target optimisations
#
CT_TARGET_CFLAGS="-mlongcalls"
CT_OVERLAY_NAME="lx106"
CT_OVERLAY_LOCATION="${CT_TOP_DIR}/overlays"

#
# Tuple completion and aliasing
#
CT_TARGET_VENDOR="lx106"

#
# Generic target options
#
CT_MULTILIB=y

#
# Debug facilities
#
CT_DEBUG_GDB=y
CT_GDB_V_9_1=y

#
# C-library
#
CT_LIBC_NONE=y

#
# C compiler
#
CT_GCC_V_9_2_0=y
CT_CC_GCC_ENABLE_CXX_FLAGS="-ffunction-sections -fdata-sections"

#
# Binary utilities
#
CT_BINUTILS_V_2_34=y

