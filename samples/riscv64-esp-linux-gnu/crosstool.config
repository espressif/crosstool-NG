CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_PREFIX_DIR="${CT_TOP_DIR}/builds/${CT_TARGET}"
CT_ARCH_RISCV=y
CT_MULTILIB=y
CT_ARCH_USE_MMU=y
CT_ARCH_64=y
CT_ARCH_ARCH="rv64gc"
CT_TARGET_VENDOR="esp"
CT_KERNEL_LINUX=y
CT_LINUX_V_6_6=y
CT_BINUTILS_SRC_DEVEL=y
CT_BINUTILS_DEVEL_URL="https://github.com/espressif/binutils-gdb.git"
CT_BINUTILS_DEVEL_BRANCH="esp-linux-14.1.1_20260203"
CT_BINUTILS_V_2_42=y
CT_GLIBC_SRC_DEVEL=y
CT_GLIBC_DEVEL_URL="https://github.com/espressif/glibc.git"
CT_GLIBC_DEVEL_BRANCH="linux-multilib"
CT_GLIBC_V_2_41=y
CT_GCC_SRC_DEVEL=y
CT_GCC_DEVEL_URL="https://github.com/espressif/gcc.git"
CT_GCC_DEVEL_BRANCH="linux-multilib"
CT_GCC_V_14=y
CT_CC_LANG_CXX=y
CT_DEBUG_GDB=y
CT_GDB_SRC_DEVEL=y
CT_GDB_DEVEL_URL="https://github.com/espressif/binutils-gdb.git"
CT_GDB_DEVEL_BRANCH="esp-linux-14.1.1_20260203"
CT_GDB_V_15=y
# CT_GDB_CROSS_PYTHON is not set
